# systemd user unit for the local model server (profile "orta" = Qwen3.5-9B, 127.0.0.1:8080).
# Generated by `bash 20-sistem/kurulum/kur.sh --genel` (fills __ATOLYE__); enable: systemctl --user enable --now llama-server
[Unit]
Description=Atölye yerel model sunucusu (llama-server, orta profil)
After=default.target

[Service]
ExecStart=/usr/bin/env bash __ATOLYE__/30-programlar/yerel-modeller/sunucu.sh orta
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
